                fetch="https://github.com" />

        <!-- Remove duplicate protobuf vendorcompat definitions -->
        <remove-project name="LineageOS/android_hardware_lineage_compat" />

        <!-- LGE Hardware Specific Support -->
        <project path="hardware/lge" name="rainbowdashh/android_hardware_lge" remote="rem" revision="lineage-23.2" clone-depth="1" />

        <!-- Device Trees -->
        <project path="device/lge/mh2lm" name="tryhardkip/android_device_lge_mh2lm" remote="rem" revision="infinity-23.2" clone-depth="1" />
        <project path="device/lge/sm8150-common" name="tryhardkip/android_device_lge_sm8150-common" remote="rem" revision="infinity-23.2" clone-depth="1" />

        <!-- Vendor Blobs (Using standard LineageOS proprietary mirrors) -->
